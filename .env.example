# Supabase (required) — get from your Supabase project settings → API
# 100% FREE: 500MB DB, 1GB storage, 50K auth users/mo. No credit card.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AI Vision API (for clothing classification)
# DEFAULT: Google Gemini — 100% FREE, 1500 requests/day, no credit card
# Get your free key at: https://aistudio.google.com/apikey
NEXT_PUBLIC_AI_API_KEY=your-free-gemini-api-key
NEXT_PUBLIC_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
NEXT_PUBLIC_AI_MODEL=gemini-2.0-flash

# AI Image Generation (for virtual try-on) — optional, falls back to collage mode
IMAGE_GEN_API_KEY=your-free-gemini-api-key
IMAGE_GEN_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
