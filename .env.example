# Supabase (required) — get from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AI Vision API (for clothing classification) — OpenAI-compatible endpoint
# Works with OpenAI, Gemini (via proxy), Groq, or any OpenAI-compatible API
AI_API_KEY=your-api-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# AI Image Generation (for virtual try-on) — optional, falls back to collage mode
IMAGE_GEN_API_KEY=your-image-gen-key
IMAGE_GEN_BASE_URL=https://api.openai.com/v1
